<?xml version="1.0" encoding="utf-8"?>
<!--
  Explicit extraction rules for Android 12+ (API 31+). allowBackup="false"
  disables cloud backups on stock Android, but some manufacturers keep
  device-to-device migration available; these rules exclude every domain
  from BOTH paths so wallet prefs and cached state never leave the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
